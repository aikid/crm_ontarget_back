PORT=3333
NODE_ENV=development
DATABASE_URL="postgresql://ontarget:ontarget_dev@localhost:5433/ontarget_test?schema=public"
# Uma ou mais origens exatas, separadas por vírgula e sem caminhos.
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=https://tipper-surgical-vowel.ngrok-free.dev
SESSION_COOKIE_NAME=ontarget.sid
SESSION_TTL_HOURS=12
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
# Em produção cross-site (Vercel + Render), use true com SameSite=none e Secure=true.
SESSION_COOKIE_PARTITIONED=false
SEED_PASSWORD=OnTarget@123

# Google Sheets: JSON completo da chave da conta de serviço em uma única variável.
# Compartilhe cada planilha como Leitora com o client_email presente nesse JSON.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# Asterisk/ARI. Durante o desenvolvimento local, as URLs apontam para o túnel SSH.
# Na mesma VM do Asterisk, utilize 127.0.0.1:8088. Nunca exponha /ari publicamente.
ASTERISK_ENABLED=false
ARI_HTTP_URL=http://127.0.0.1:18088
ARI_WS_URL=ws://127.0.0.1:18088
ARI_APP=crm_browser_poc
ARI_USER=
ARI_PASSWORD=
ASTERISK_SIP_WSS_URL=ws://127.0.0.1:18088/ws
ASTERISK_SIP_DOMAIN=34.95.194.220
# Produção: um ramal exclusivo por SDR, indexado pelo e-mail autenticado.
# ASTERISK_SIP_ACCOUNTS_JSON={"ana@empresa.com":{"extension":"201","password":"segredo"},"diego@empresa.com":{"extension":"202","password":"segredo"}}
ASTERISK_SIP_ACCOUNTS_JSON=
# POC local com apenas um SDR. Nunca habilitar compartilhamento em produção.
ASTERISK_ALLOW_SHARED_SIP_ACCOUNT=false
ASTERISK_SIP_EXTENSION=
ASTERISK_SIP_PASSWORD=
ASTERISK_INTERNAL_EXTENSION=902
ASTERISK_WEB_APP_ARG=web201
ASTERISK_WEB_CHANNEL_PREFIX=PJSIP/201-
OVERTELE_TRUNK_NAME=overtele
CALL_INTENT_TTL_SECONDS=30
MAX_CALL_SECONDS=7200
ARI_RECONNECT_MIN_MS=1000
ARI_RECONNECT_MAX_MS=30000

# Legado temporário durante a migração. Será removido quando o motor ARI assumir as rotas.
CX3_PBX_URL=https://8rtech.my3cx.com.br
CX3_CLIENT_ID=crmontarget
CX3_CLIENT_SECRET=
CX3_APP_DN=crmontarget
